# 飞书应用配置
FEISHU_APP_ID=cli_xxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxx

# 飞书群聊Webhook（可选，用于简单发送消息）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxxxx

# 多维表配置
# 在多维表页面，从浏览器地址栏复制：
# 例如: https://[域名]/base/[APP_TOKEN]?table=tblxxxxxx
FEISHU_DOMAIN=bcnesjc7qzvb.feishu.cn
BITABLE_APP_TOKEN=xxxxxxxxxx
BITABLE_TABLE_ID=tblTvTLTdoeeLCfF

# 可选：多维表查看详情基础URL（如果是wiki嵌入的多维表需要配置）
# BITABLE_DETAIL_BASE_URL=https://bcnesjc7qzvb.feishu.cn/wiki/QIOywbdG8ixc6kkVqjWcwYU3nzh

# 多维表字段名配置（根据你的实际字段名修改）
BITABLE_STATUS_FIELD=项目状态
BITABLE_HANDLER_FIELD=项目负责人
BITABLE_COMPLETED_VALUE=已完成

# 服务器配置
PORT=3000
